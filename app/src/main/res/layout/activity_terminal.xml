<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FF1A1A2E">

    <ScrollView
        android:id="@+id/terminal_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/terminal_shortcuts"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <TextView
            android:id="@+id/terminal_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#FF00FF00"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/terminal_shortcuts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FF0D0D1A"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toTopOf="@id/divider"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/terminal_scroll">

        <Button
            android:id="@+id/btn_regression"
            style="@style/TerminalShortcut"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:text="@string/terminal_regression" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_clear"
                    style="@style/TerminalShortcut"
                    android:text="@string/terminal_clear" />
                <Button
                    android:id="@+id/btn_scan"
                    style="@style/TerminalShortcut"
                    android:text="@string/terminal_props" />
                <Button
                    android:id="@+id/btn_list"
                    style="@style/TerminalShortcut"
                    android:text="@string/terminal_help" />
                <Button
                    android:id="@+id/btn_disconnect"
                    style="@style/TerminalShortcut"
                    android:text="@string/terminal_disconnect" />
                <Button
                    android:id="@+id/btn_share"
                    style="@style/TerminalShortcut"
                    android:text="@string/terminal_share" />
                <Button
                    android:id="@+id/btn_perm"
                    style="@style/TerminalShortcut"
                    android:text="@string/terminal_props" />
                <Button
                    android:id="@+id/btn_help"
                    style="@style/TerminalShortcut"
                    android:text="@string/terminal_help" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF00FF00"
        app:layout_constraintBottom_toTopOf="@id/terminal_input"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/terminal_shortcuts" />

    <EditText
        android:id="@+id/terminal_input"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF0D0D1A"
        android:fontFamily="monospace"
        android:textColor="#FF00FF00"
        android:textColorHint="#666666"
        android:hint="@string/terminal_input_hint"
        android:imeOptions="actionSend"
        android:inputType="text"
        android:padding="12dp"
        android:textSize="11sp"
        android:maxLines="3"
        android:gravity="top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintHeight_percent="0.15" />

</androidx.constraintlayout.widget.ConstraintLayout>
